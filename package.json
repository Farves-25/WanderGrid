{
  "name": "wander-grid",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "config": "node --env-file-if-exists=.env scripts/gen-supabase-config.mjs",
    "start": "concurrently -k -n api,web -c cyan,magenta \"npm:api\" \"ng serve\"",
    "api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "serve": "node --env-file-if-exists=.env server/index.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false && npm run test:server",
    "test:server": "node --test server/",
    "prestart": "npm run config",
    "prebuild": "npm run config",
    "pretest": "npm run config"
  },
  "private": true,
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.6",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/postcss": "^4.3.5",
    "lucide": "^1.73.0",
    "postcss": "^8.5.33",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "concurrently": "^10.0.7",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
