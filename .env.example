# Copy this file to .env and fill in your key. .env is git-ignored.

# Required for live flight data. Free plan: https://serpapi.com/users/sign_up
# Find the key at https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# Optional: port for the API server (the dev proxy expects 8787)
# PORT=8787

# Optional: two-letter country code for Google Flights (changes which booking sites are listed), e.g. us, gb, in, ae
# SERPAPI_GL=

# Google sign-in via Supabase (Project Settings -> API). Public values, but kept out of git.
# Set both, or neither to hide the Google button. Also set these in your hosting build env.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_or_publishable_key
